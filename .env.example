# Copy this file to .env and fill in real values. .env is git-ignored.

# Python interpreter used to run analyze_image.py.
# Use "python", "python3", or an absolute path to a virtualenv interpreter.
PYTHON_PATH=python3

# multipart/form-data field name the mobile app must use.
UPLOAD_FIELD_NAME=image
# Maximum upload size in bytes (10 MB default).
UPLOAD_MAX_SIZE_BYTES=10485760
